#: savers/footlogo-floaters.desktop.in.in:3
msgid "Floating MATE"
msgstr "Қалқымалы MATE"

#: savers/footlogo-floaters.desktop.in.in:4
msgid "Bubbles the MATE logo around the screen"
msgstr "MATE логотипін экран бойымен көпіршіктер түрінде қозғалтады"

#. Translators: Search terms to find this application. Do NOT translate or
#. localize the semicolons! The list MUST also end with a semicolon!
#: savers/footlogo-floaters.desktop.in.in:12
msgid "MATE;screensaver;logo;bubbles;"
msgstr "MATE;screensaver;logo;bubbles;логотип;көпіршіктер;"

#: savers/gnomelogo-floaters.desktop.in.in:3
msgid "Floating GNOME"
msgstr "Қалқымалы GNOME"

#: savers/gnomelogo-floaters.desktop.in.in:4
msgid "Bubbles the GNOME logo around the screen"
msgstr "GNOME логотипін экран бойымен көпіршіктер түрінде қозғалтады"

#. Translators: Search terms to find this application. Do NOT translate or
#. localize the semicolons! The list MUST also end with a semicolon!
#: savers/gnomelogo-floaters.desktop.in.in:12
msgid "MATE;screensaver;GNOME;logo;bubbles;"
msgstr "MATE;screensaver;GNOME;logo;bubbles;логотип;көпіршіктер;"

#: savers/personal-slideshow.desktop.in.in:3
msgid "Pictures folder"
msgstr "Суреттер бумасы"

#: savers/personal-slideshow.desktop.in.in:4
msgid "Display a slideshow from your Pictures folder"
msgstr "Суреттер бумасынан слайдшоу көрсету"

#. Translators: Search terms to find this application. Do NOT translate or
#. localize the semicolons! The list MUST also end with a semicolon!
#: savers/personal-slideshow.desktop.in.in:12
msgid "MATE;screensaver;custom;slideshow;pictures;folder;"
msgstr ""
"MATE;screensaver;custom;slideshow;pictures;folder;пайдаланушылық;слайдшоу;суреттер;бума;"

#: savers/popsquares.desktop.in.in:3
msgid "Pop art squares"
msgstr "Поп-арт шаршылары"

#: savers/popsquares.desktop.in.in:4
msgid "A pop-art-ish grid of pulsing colors."
msgstr "Пульсацияланатын түстердің поп-арт стиліндегі торы."

#. Translators: Search terms to find this application. Do NOT translate or
#. localize the semicolons! The list MUST also end with a semicolon!
#: savers/popsquares.desktop.in.in:12
msgid "MATE;screensaver;grid;pulsing;colors;"
msgstr "MATE;screensaver;grid;pulsing;colors;тор;пульсация;түстер;"

#: savers/popsquares.c:50 savers/floaters.c:1161
#, c-format
msgid "%s. See --help for usage information.\n"
msgstr "%s. Пайдалану ақпаратын --help арқылы қараңыз.\n"

#: savers/floaters.c:1134
msgid "Show paths that images follow"
msgstr "Суреттер ізімен жүретін жолдарды көрсету"

#: savers/floaters.c:1136
msgid "Occasionally rotate images as they move"
msgstr "Суреттер қозғалған кезде оларды анда-санда бұру"

#: savers/floaters.c:1138
msgid "Print out frame rate and other statistics"
msgstr "Кадр жиілігін және басқа статистиканы басып шығару"

#: savers/floaters.c:1140
msgid "The maximum number of images to keep on screen"
msgstr "Экранда сақталатын суреттердің максималды саны"

#: savers/floaters.c:1140
msgid "MAX_IMAGES"
msgstr "MAX_IMAGES"

#: savers/floaters.c:1142
msgid "The initial size and position of window"
msgstr "Терезенің бастапқы өлшемі мен орны"

#: savers/floaters.c:1142
msgid "WIDTHxHEIGHT+X+Y"
msgstr "WIDTHxHEIGHT+X+Y"

#: savers/floaters.c:1144
msgid "The source image to use"
msgstr "Пайдаланылатын дереккөз сурет"

#: savers/floaters.c:1156
msgid "image - floats images around the screen"
msgstr "сурет - суреттерді экран бойымен қозғалтады"

#: savers/floaters.c:1170
msgid "You must specify one image.  See --help for usage information.\n"
msgstr ""
